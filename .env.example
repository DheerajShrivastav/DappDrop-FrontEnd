# Environment Variables Template
# Copy this file to .env.local and fill in your actual values

# === DATABASE ===
DATABASE_URL="postgresql://user:password@localhost:5432/dappdrop"

# === BLOCKCHAIN (Web3Campaigns v0.6.0) ===
# Target chain. Sepolia = 11155111 (dev/beta); a future L2 is added to config.ts ADDRESS_BOOK.
NEXT_PUBLIC_CHAIN_ID="11155111"
# Entrypoint (Web3Campaigns) — the only address strictly required; falls back to the
# chain's ADDRESS_BOOK entry in src/app/config.ts when unset.
NEXT_PUBLIC_CAMPAIGN_FACTORY_CONTRACT="0xf0A2Fac02ffBA4A7762f2f0d611253B6C97bB1B3"
NEXT_PUBLIC_RPC_URL="https://rpc.sepolia.org"
NEXT_PUBLIC_SEPOLIA_RPC_URL="https://rpc.sepolia.org"
# Satellite module GLOBAL DEFAULTS — optional overrides (defaults live in config.ts).
# Per-campaign pinned modules are ALWAYS read from chain state, never from these.
# NEXT_PUBLIC_ONCHAIN_REWARD_MODULE="0x..."
# NEXT_PUBLIC_NFT_SETTLEMENT_MODULE="0x..."
# NEXT_PUBLIC_FEE_MODULE="0x..."   # leave unset when fees are disabled

# === EIP-712 SIGNER SERVICE (SIGNER_ROLE) — server-side only ===
# Never NEXT_PUBLIC_; never logged. The signer (src/lib/signer.ts) signs TaskAttestation
# messages consumed by verifyTaskCompletionWithSignature. On this throwaway test deployment
# this is the DEPLOYER key (which holds SIGNER_ROLE); at beta it moves to a KMS handle
# (docs/DECISIONS_v0.6.0.md Decision 1) — a change to loadSigningWallet() only.
# SIGNER_PRIVATE_KEY="0x..."
#
# Submitter wallet that broadcasts the attestation tx (must hold testnet ETH for gas).
# If unset it FALLS BACK to SIGNER_PRIVATE_KEY — acceptable only on this test rig. A real
# deployment MUST set a separate key so a compromised submitter can't also forge signatures.
# SUBMITTER_PRIVATE_KEY="0x..."

# === KEEPER (worker/keeper.ts) — server-side only ===
# Never NEXT_PUBLIC_; never logged. Dedicated low-value hot key that ONLY ever calls the
# permissionless endCampaign — never the SIGNER_ROLE or submitter key above (same
# key-separation principle: a compromised keeper key can only end campaigns on schedule,
# nothing more, since endCampaign is permissionless anyway). Must hold testnet ETH for gas.
# Run `npm run keeper:dry-run` to list endable campaigns without sending; `npm run keeper`
# for a one-shot sweep (cron); `npm run keeper:loop` for an always-on polling process.
# KEEPER_PRIVATE_KEY="0x..."
# KEEPER_INTERVAL_MINUTES=5
# KEEPER_MAX_ATTEMPTS=3
# KEEPER_OVERDUE_ALERT_MINUTES=30
# KEEPER_TX_TIMEOUT_MS=120000

# === THE GRAPH (optional; rebuild against v0.6.0 before enabling — TODO(P0)) ===
# Deploy the rebuilt subgraph in /subgraph to Subgraph Studio, then paste the query URL here.
# When set, campaign list and participant queries use the subgraph instead of N+1 RPC calls.
# Leave EMPTY until the subgraph is rebuilt for v0.6.0 (Decision 3) — reads fall back to RPC.
# Format: https://api.studio.thegraph.com/query/<id>/dappdrop/version/latest
NEXT_PUBLIC_GRAPH_API_URL=""

# === AI SERVICE ===
GEMINI_API_KEY="your-gemini-api-key"

# === AUTHENTICATION ===
NEXTAUTH_URL="http://localhost:3000"
NEXTAUTH_SECRET="your-nextauth-secret"

# === DISCORD INTEGRATION ===
DISCORD_CLIENT_ID="your-discord-client-id"
DISCORD_CLIENT_SECRET="your-discord-client-secret"
DISCORD_BOT_TOKEN="your-discord-bot-token"

# === TELEGRAM INTEGRATION ===
TELEGRAM_BOT_TOKEN="your-telegram-bot-token"
TELEGRAM_BOT_USERNAME="your-bot-username"

# === HUMANITY PROTOCOL (v2 - OAuth SDK) ===
# Register your app at https://developers.humanity.org/ to get credentials
NEXT_PUBLIC_HUMANITY_CLIENT_ID="your-client-id"
NEXT_PUBLIC_HUMANITY_REDIRECT_URI="http://localhost:3000/humanity-callback"
NEXT_PUBLIC_HUMANITY_ENVIRONMENT="sandbox"
# Portal URL for user reference
NEXT_PUBLIC_HUMANITY_PORTAL_URL="https://testnet.humanity.org"

# === UPLOADTHING ===
# Get your API keys from https://uploadthing.com/dashboard
UPLOADTHING_SECRET="sk_live_..."
UPLOADTHING_APP_ID=g159p6itzj
