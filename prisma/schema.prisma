// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Looking for ways to speed up your queries, or scale easily with your serverless or edge functions?
// Try Prisma Accelerate: https://pris.ly/cli/accelerate-init

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// Simplified schema focusing on enhancements, not duplicating on-chain data

model User {
  id            String @id @default(cuid())
  walletAddress String @unique

  // OFF-CHAIN ONLY enhancements
  username             String?
  email                String?
  notificationSettings Json?
  preferences          Json?

  // NEW: NextAuth + Discord fields
  name          String? // NextAuth standard field
  emailVerified DateTime?
  image         String?
  discordId     String?   @unique // Store Discord user ID

  // Humanity Protocol verification.
  // humanityVerified is the DURABLE status (docs/HUMANITY_GATING.md: "one OAuth, once per
  // wallet, ever") — the authoritative input to Merkle tree-build gating (src/lib/allocation.ts).
  // lastHumanityCheck is a freshness timestamp used ONLY by the TTL-bounded courtesy read
  // (isUserVerified, used by the verify-task path + the sponsored-claim relayer); it must NOT
  // gate tree-build enforcement, or a genuinely-verified human whose check merely aged past the
  // TTL would lose their leaf and be permanently locked out of earned rewards.
  // humanityRevokedAt: set when Humanity Protocol reports a previously-verified wallet revoked;
  // revocation flips humanityVerified=false so FUTURE tree builds exclude it (already-published
  // roots are immutable — accepted limitation, docs/HUMANITY_GATING.md).
  humanityVerified  Boolean   @default(false)
  lastHumanityCheck DateTime?
  humanityRevokedAt DateTime?

  // Moderation gate for sponsored (gasless) claims (PRD BR-R*, see worker/relayer.ts).
  // Self-claim is NEVER affected by this — it only blocks the platform from paying gas on
  // this wallet's behalf. Flagged manually (no automated flagging pipeline in this phase).
  moderationFlagged Boolean @default(false)
  moderationReason  String?

  // NextAuth relations
  accounts Account[]
  sessions Session[]

  createdAt DateTime @default(now())
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String // This will store the Discord user ID
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

// NextAuth Session model
model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

// NextAuth Verification Token model (for email verification, etc.)
model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

model CampaignCache {
  id              String @id @default(cuid())
  campaignId      Int // Reference to on-chain campaign ID
  contractAddress String

  // CACHED data for performance (synced from blockchain)
  title       String
  description String
  hostAddress String
  isActive    Boolean

  // OFF-CHAIN enhancements
  imageUrl         String?
  shortDescription String? // User-provided short description for cards/sidebar
  longDescription  String? // User-provided detailed description for campaign page
  tags             String[]
  featuredUntil    DateTime?

  // Reward metadata (off-chain, since blockchain stores only type/address/amount)
  rewardType String? // "ERC20", "ERC721", "None"
  rewardName String? // User-provided name/description for the reward

  // v0.6.0 allocation policy (PRD BR-G2). No contract field for either — off-chain policy
  // consumed by the allocation pipeline (src/lib/allocation.ts) at tree-build time.
  // humanityGated: the per-campaign sybil-gating toggle (docs/HUMANITY_GATING.md) — for
  // Merkle campaigns, enforcement is tree-build filtering (unverified wallets get no leaf).
  humanityGated    Boolean @default(false)
  // allocationPolicy: committed at creation, shown to participants before Open (FR-H4).
  // CP2 ships one policy (PRD Q3 default): EQUAL_SPLIT among wallets that completed every
  // task. The column is a string (not an enum) so new policies can be added without a
  // migration once P3 needs them.
  allocationPolicy String  @default("EQUAL_SPLIT")

  // P3 CP4 — admin moderation. Off-chain ONLY: hides the campaign from the public discovery
  // listing (getAllCampaigns' public-facing callers). Deliberately does NOT touch escrow,
  // tasks, or claims — a hidden campaign's participants can still complete tasks and claim by
  // direct link; this only controls whether it's surfaced in the public list. The UI must say
  // so explicitly wherever this toggle appears.
  hiddenFromDiscovery Boolean @default(false)
  hiddenReason        String?

  lastSyncedAt DateTime @default(now())
}

model CampaignTaskMetadata {
  id         String @id @default(cuid())
  campaignId Int // On-chain campaign ID
  taskIndex  Int // Task index in the campaign
  taskType   String // JOIN_DISCORD, JOIN_TELEGRAM, SOCIAL_FOLLOW, etc.

  // Discord-specific metadata
  discordInviteLink String?
  discordServerId   String? // Discord server ID for verification

  // Telegram-specific metadata
  telegramInviteLink String?
  telegramChatId     String?

  // Humanity Protocol verification requirement
  requiresHumanityVerification Boolean @default(false)

  // Other task metadata can be added here in the future
  metadata Json?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([campaignId, taskIndex])
}

model SocialVerification {
  id          String @id @default(cuid())
  userAddress String
  taskId      String // On-chain task reference
  platform    String // twitter, discord, etc.

  // Verification proof (off-chain)
  proofData  Json
  verifiedAt DateTime?
  isValid    Boolean   @default(false)
}

model Analytics {
  id          String  @id @default(cuid())
  eventType   String
  userAddress String?
  campaignId  Int? // On-chain campaign ID reference

  data      Json
  timestamp DateTime @default(now())
}

// Failed task-verification attempts (P3 CP3 — host analytics). AttestationRecord already logs
// every PASS (BR-V4 audit log); nothing previously recorded a FAIL — /api/verify-task's failure
// paths only ever returned an HTTP response to the client, never persisted anything. Deliberately
// carries NO wallet/user identifier — this is an aggregation-only log by construction (the P3
// prompt's own "surface verifier-failure reasons aggregated, not per-user"), not a redacted view
// of a richer table.
model VerificationFailure {
  id         String   @id @default(cuid())
  campaignId Int
  taskIndex  Int
  taskType   String?
  reason     String // short categorical reason (e.g. "discord_not_joined", "humanity_pending")
  createdAt  DateTime @default(now())

  @@index([campaignId, taskIndex])
}

// One row per worker/keeper.ts sweep (P3 CP4 admin console — "keeper health: recent run log").
// Nothing previously persisted keeper activity beyond console output, lost on restart/redeploy.
model KeeperRun {
  id            String   @id @default(cuid())
  startedAt     DateTime @default(now())
  finishedAt    DateTime?
  endableCount  Int      @default(0)
  endedCount    Int      @default(0)
  failedCount   Int      @default(0)
  alertCount    Int      @default(0) // BR-K2: campaigns overdue past KEEPER_OVERDUE_ALERT_MINUTES
  error         String? // set if the sweep itself threw before completing

  @@index([startedAt])
}

// Append-only audit log of every EIP-712 attestation the SIGNER_ROLE service signs
// (PRD BR-V4). Records who/what/when + the evidence that justified signing. Deliberately
// does NOT store the raw signature or any key material — the signature is returned to the
// caller for submission/self-submit but never persisted or logged.
model AttestationRecord {
  id          String @id @default(cuid())
  campaignId  Int
  taskIndex   Int
  participant String // lowercased wallet the attestation is FOR

  completed Boolean // the `completed` flag that was signed (true = task done)
  version   Int // the version signed (= on-chain current + 1 at signing time)
  deadline  DateTime // signature deadline (<= 1h from signing, BR-V2)

  signerAddress String // address derived from the signing key (NOT the key itself)
  evidence      Json // verifier result snapshot that justified this signature

  submitted Boolean @default(false) // did the backend submit the tx itself?
  txHash    String? // set once submitted on-chain

  createdAt DateTime @default(now())

  // Concurrency guard: two near-simultaneous requests can both read the same on-chain
  // version and both sign it, but only the first INSERT for a given
  // (campaign, task, wallet, version) wins — the second gets a clean "try again" error
  // instead of handing out a second signature doomed to revert (see src/lib/signer.ts).
  @@unique([campaignId, taskIndex, participant, version])
  @@index([campaignId, taskIndex, participant])
  @@index([participant])
}

// Allocation & Merkle pipeline (PRD BR-M1/M2/M4). One row per PROPOSED/PUBLISHED/SUPERSEDED
// tree version for a campaign — versions are NEVER deleted (proofs must be servable for
// years, BR-M2), superseded ones are just marked so the proof API only serves the active one.
// The pipeline PROPOSES; the host reviews and PUBLISHES by signing setERC20MerkleRoot
// themselves (BR-M3) — this table never grants the backend authority to publish on its own.
model MerkleTree {
  id          String @id @default(cuid())
  campaignId  Int
  version     Int // increments per (re)proposal for this campaign, starting at 1
  root        String // 0x-prefixed bytes32, OZ StandardMerkleTree root
  token       String // reward token (ERC20) OR NFT collection address (NFT), for display/reconciliation
  totalAmount String // ERC20: sum of all entries. NFT: total item count. Base units (string: exceeds safe JS integer range)
  policy      String // allocation policy used to build this tree (see CampaignCache.allocationPolicy)
  // ERC20 (default) or NFT — discriminates which leaf encoding this tree/its entries use
  // (src/lib/allocation.ts vs src/lib/nft-allocation.ts) and which claim UI/proof shape
  // applies. P3 CP2: NFT reuses this SAME model rather than a parallel one, per the standing
  // "extend, don't duplicate" instruction — only entry-level fields differ (nftStandard/tokenId).
  rewardKind  String @default("ERC20")
  // Full StandardMerkleTree.dump() output — the only way to regenerate a wallet's proof
  // later without recomputing the whole tree from scratch (BR-M2's "proofs servable for years").
  treeJson    Json
  // PROPOSED: pipeline output, not yet signed on-chain. PUBLISHED: the host (or, later,
  // SETTLER_ROLE) actually called setERC20MerkleRoot with this root — cross-checked against
  // chain state before being trusted for anything value-bearing (BR-I4). SUPERSEDED: a later
  // version was proposed/published for this campaign.
  status      String @default("PROPOSED")

  // Wallets that qualified by tasks but were EXCLUDED from the leaf set by humanity gating
  // (docs/HUMANITY_GATING.md point 1). Persisted (not just returned from the propose call) so
  // the host-review panel can show who was filtered out on any later page load before the host
  // signs setERC20MerkleRoot — otherwise a wrong exclusion (a real human who forgot to verify,
  // or a fail-closed transient DB error at tree-build) would be published invisibly. Empty for
  // non-gated campaigns.
  excludedForHumanity String[]

  createdAt   DateTime  @default(now())
  publishedAt DateTime? // best-effort, client-reported at the moment setERC20MerkleRoot succeeded

  entries AllocationEntry[]

  @@unique([campaignId, version])
  @@index([campaignId, status])
  @@index([campaignId, root])
}

// One qualifying wallet's allocation within a specific MerkleTree version.
model AllocationEntry {
  id             String     @id @default(cuid())
  merkleTreeId   String
  merkleTree     MerkleTree @relation(fields: [merkleTreeId], references: [id])
  campaignId     Int // denormalized for a fast per-campaign+wallet lookup (proof API)
  wallet         String // lowercased
  // ERC20: reward amount, base units. NFT/ERC1155: item quantity. NFT/ERC721: always "1"
  // (the leaf commits an amount even though executeNFTTransferOut ignores it for ERC721 —
  // verified against NFTSettlementModule.sol; the claim call's amount arg must match the
  // leaf's exactly or the proof fails, so "1" is a fixed convention, not a free choice).
  amount         String
  leafIndex      Int // index into the OZ tree — required to regenerate this wallet's proof
  tasksCompleted Int

  // NFT-only (null for ERC20 entries): CampaignStorage.NFTStandard as a string, and the
  // specific tokenId this wallet was allocated. One NFT collection per campaign for now (the
  // MerkleTree.token field) — the default "smallest reasonable" policy; multi-collection
  // campaigns are a follow-up.
  nftStandard String?
  tokenId     String?

  createdAt DateTime @default(now())

  @@unique([merkleTreeId, wallet])
  @@index([campaignId, wallet])
}

// Deposited NFT inventory for a campaign, tracked off-chain because the contract exposes no
// enumerable view of "every tokenId ever deposited" — only per-tokenId escrow booleans/amounts
// (isERC721Escrowed/getERC1155Escrowed) and a deposit COUNT event (NFTRewardsDeposited), never
// the actual tokenIds. Written by the wizard at deposit time; read by the NFT allocation
// pipeline (src/lib/nft-allocation.ts) as the pool of items to assign. One row per deposited
// tokenId (an ERC1155 amount>1 is one indivisible item awarded to a single winner — splitting
// one tokenId's balance across multiple winners is a follow-up, not this default policy).
model NFTDeposit {
  id           String  @id @default(cuid())
  campaignId   Int
  tokenAddress String
  standard     String // 'ERC721' | 'ERC1155'
  tokenId      String
  amount       String // '1' for ERC721 (fixed convention), quantity for ERC1155
  // Consumed by an allocation entry — round-robin bookkeeping so re-proposing doesn't hand the
  // same item to two different wallets across proposal versions.
  allocated Boolean @default(false)

  createdAt DateTime @default(now())

  @@unique([campaignId, tokenAddress, tokenId])
  @@index([campaignId, allocated])
}

// x402 Payment Protocol - Minimal implementation (like Humanity Protocol)
model PaymentVerification {
  id              String    @id @default(cuid())
  campaignId      Int
  taskIndex       Int
  userAddress     String
  transactionHash String    @unique
  verified        Boolean   @default(false)
  verifiedAt      DateTime?

  createdAt DateTime @default(now())

  @@unique([campaignId, taskIndex, userAddress])
  @@index([userAddress])
}

// ---------------------------------------------------------------------------
// Sponsored (gasless) claim relayer — P2, PRD BR-R*. See worker/relayer.ts.
//
// The relayer NEVER redirects funds (claimERC20For always pays `account`, verified against
// the deployed contract — see docs/REWARD_SYSTEM.md); it only decides whether the PLATFORM
// pays gas for a claim that the wallet could always submit itself. Self-claim is independent
// of every model below and is never gated by them.
// ---------------------------------------------------------------------------

// One request per (campaignId, account), ever — the row IS the dedupe/idempotency key. A
// repeat POST to the enqueue endpoint for the same wallet+campaign returns the existing row's
// status rather than creating a second request. Retries after a transient failure reuse the
// same row (status reset to PENDING, attempts incremented), never a new one.
model SponsoredClaim {
  id         String @id @default(cuid())
  campaignId Int
  account    String // lowercased wallet the claim is FOR (never the relayer's own address)

  // ERC20_MERKLE (default, P2 CP1): claimERC20For(campaignId, account, amount, proof) on the
  // entrypoint. TIERED (P3 CP1): claimRewardFor(campaignId, account) on the campaign's PINNED
  // OnChainRewardModule — no amount/proof needed, the module computes payout from on-chain
  // rank/score state. NFT (P3 CP2): claimNFTFor(campaignId, account, standard, token, tokenId,
  // amount, proof) on the campaign's PINNED NFTSettlementModule. A campaign is exactly one
  // settlement mode (contract-enforced, mutually exclusive), so (campaignId, account) stays a
  // valid dedupe key across all three kinds.
  kind String @default("ERC20_MERKLE")

  // ERC20_MERKLE/NFT snapshot at enqueue time (from AllocationEntry) — the worker re-verifies
  // this is still the CURRENTLY PUBLISHED root's data immediately before submitting (never
  // trusts a stale snapshot for the actual send), but keeps it here so a request is
  // self-contained and auditable even if the underlying tree is later superseded. Unused
  // (amount="0", proof=[]) for kind=TIERED, whose payout is computed on-chain, not looked up here.
  amount String // base units (ERC20_MERKLE) or NFT item quantity (NFT)
  proof  Json // string[] Merkle proof (ERC20_MERKLE/NFT); [] for TIERED
  token  String // reward token address (ERC20_MERKLE) or NFT collection address (NFT)

  // NFT-only (null otherwise): CampaignStorage.NFTStandard as a string, and the specific
  // tokenId this wallet was allocated.
  nftStandard String?
  tokenId     String?

  // PENDING: enqueued, not yet picked up. PROCESSING: claimed by a worker (atomic
  // PENDING->PROCESSING transition is the cross-instance concurrency guard — see
  // worker/relayer.ts). SUBMITTED: tx sent, awaiting confirmation. CONFIRMED: mined + verified
  // successful on-chain. FAILED: exhausted retries or hit an unexpected error. DECLINED: a
  // gating check failed BEFORE any tx was sent (declineReason is UI-showable, routes the user
  // to self-claim).
  status        String  @default("PENDING")
  declineReason String?

  attempts  Int     @default(0)
  lastError String?

  // Set once a tx is actually sent, so a stuck tx can be replaced (same nonce, bumped gas)
  // rather than accidentally double-spent with a second independent send.
  nonce         Int?
  txHash        String?
  gasUsed       String? // wei
  effGasPrice   String? // wei, effective gas price paid
  gasCostWei    String? // gasUsed * effGasPrice — what gets attributed to the budget rows below

  requestedAt DateTime  @default(now())
  processedAt DateTime? // set when status reaches a terminal state (CONFIRMED/FAILED/DECLINED)

  @@unique([campaignId, account])
  @@index([status])
  @@index([campaignId])
}

// Per-campaign sponsorship ceiling (native gas token, wei) — headroom check (b) in the
// relayer's gating list. Lazily created with a config-driven default on a campaign's first
// sponsorship request (see worker/relayer.ts); hosts do not yet have a UI to set this
// per-campaign in CP1 — flagged as a follow-up, the default applies uniformly for now.
model CampaignSponsorshipBudget {
  id         String   @id @default(cuid())
  campaignId Int      @unique
  budgetWei  String // ceiling
  spentWei   String   @default("0") // running total, updated only on CONFIRMED
  updatedAt  DateTime @updatedAt
  createdAt  DateTime @default(now())
}

// Global daily sponsorship ceiling (native gas token, wei) — headroom check (c). One row per
// UTC day, created lazily. Querying "today's" row and comparing spentWei against the
// RELAYER_DAILY_BUDGET_WEI env ceiling is check (c); the ceiling itself is a config value; the
// row only tracks the running spend so it survives worker restarts.
model RelayerDailySpend {
  id       String @id @default(cuid())
  date     String @unique // YYYY-MM-DD, UTC
  spentWei String @default("0")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// Singleton row (id always 1) — the kill switch. Halts ALL sponsorship immediately without a
// redeploy: the worker checks this at the top of every queue tick, and the enqueue endpoint
// checks it too (so new requests are declined immediately rather than queued and stuck).
// Self-claim reads nothing from this table and is completely unaffected.
model RelayerControl {
  id                Int      @id @default(1)
  killSwitchEnabled Boolean  @default(false)
  killSwitchReason  String?
  updatedAt         DateTime @updatedAt
}

// ---------------------------------------------------------------------------
// Notification / webhook system — P2.5, PRD BR-N*. See src/lib/notifications.ts +
// worker/webhook-dispatcher.ts. No keys, no fund movement; contracts are READ-ONLY here.
// ---------------------------------------------------------------------------

// In-app notification center. One row per (recipient, event). The read path is the app
// (GET /api/notifications) — no worker needed for in-app; only webhooks have a dispatcher.
model Notification {
  id        String @id @default(cuid())
  recipient String // lowercased wallet the notification is FOR
  type      String // event type key (see src/lib/notification-events.ts)
  title     String
  body      String
  payload   Json // structured event data (campaignId, txHash, amounts, …) for the UI + deep links

  read   Boolean   @default(false)
  readAt DateTime?

  // Stable per logical (recipient, event) so a re-emit of the same lifecycle event doesn't
  // create a duplicate in-app row (idempotent emit, mirrors the webhook dedupe key).
  eventId String

  createdAt DateTime @default(now())

  @@unique([recipient, eventId])
  @@index([recipient, read])
  @@index([recipient, createdAt])
}

// A host-configured outbound webhook endpoint. The `secret` is the per-host HMAC-SHA256 signing
// key — SERVER-SIDE ONLY, never logged and never included in any payload. Signing happens once
// at enqueue time (src/lib/notifications.ts); the dispatcher worker never reads the secret.
model WebhookEndpoint {
  id          String  @id @default(cuid())
  hostAddress String // lowercased wallet of the host who owns this endpoint
  url         String
  secret      String // HMAC-SHA256 signing secret (server-side only, never logged/sent)
  active      Boolean @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  deliveries WebhookDelivery[]

  @@index([hostAddress, active])
}

// One outbound delivery attempt-set for a single (endpoint, event). The signature is computed
// ONCE at enqueue over the exact `body` bytes + `signedAt` timestamp and stored here; every
// retry resends the byte-identical body with the SAME signature + timestamp headers (re-signing
// with a fresh timestamp on retry would break the host's replay-window check). Retry policy:
// 2xx => DELIVERED; 4xx except 408/429 => FAILED (terminal, a rejected payload is not retried
// forever); 408/429/5xx/timeout/network => RETRYING with capped exponential backoff until
// maxAttempts, then FAILED.
model WebhookDelivery {
  id         String          @id @default(cuid())
  endpointId String
  endpoint   WebhookEndpoint @relation(fields: [endpointId], references: [id])

  eventId   String // stable event id, echoed in the payload + X-DappDrop-Event-Id header for host dedupe
  eventType String
  url       String // snapshot of endpoint.url at enqueue time (a later endpoint edit never rewrites in-flight deliveries)

  body      String // the EXACT JSON string that was signed and is (re)sent verbatim on every attempt
  signature String // hex HMAC-SHA256 over `${signedAt}.${body}` — computed once, resent unchanged
  signedAt  BigInt // unix seconds included in the signing string + X-DappDrop-Timestamp header

  status              String    @default("PENDING") // PENDING | DELIVERING | DELIVERED | RETRYING | FAILED
  attempt             Int       @default(0)
  maxAttempts         Int       @default(6)
  lastStatusCode      Int?
  lastResponseSnippet String? // first N chars of the response body, for the redelivery log (never the secret)
  lastError           String?
  nextRetryAt         DateTime? // when a RETRYING delivery becomes eligible again
  deliveredAt         DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Idempotency: at most one delivery per (endpoint, event) — a double-emit of the same logical
  // event is a no-op, and retries reuse this same row (so the eventId + signature stay stable).
  @@unique([endpointId, eventId])
  @@index([status, nextRetryAt])
  @@index([endpointId])
}
